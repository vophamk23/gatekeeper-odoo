<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="t4_gate_keeper_device_log_view_list" model="ir.ui.view">
        <field name="name">t4.gate_keeper.device_log.view.list</field>
        <field name="model">t4.gate_keeper.device_log</field>
        <field name="arch" type="xml">
            <list string="Device Logs" default_group_by="branch_id">
                <field name="branch_id" optional="show"/>
                <field name="device_id"/>
                <field name="controller_id"/>
                <field name="event_type"/>
                <field name="changed_at"/>
                <field name="old_status"
                       widget="badge"
                       decoration-success="old_status == 'online'"
                       decoration-warning="old_status == 'controller_offline'"
                       decoration-danger="old_status == 'offline'"/>
                <field name="new_status"
                       widget="badge"
                       decoration-success="new_status == 'online'"
                       decoration-warning="new_status == 'controller_offline'"
                       decoration-danger="new_status == 'offline'"/>
            </list>
        </field>
    </record>

    <record id="t4_gate_keeper_device_log_view_form" model="ir.ui.view">
        <field name="name">t4.gate_keeper.device_log.view.form</field>
        <field name="model">t4.gate_keeper.device_log</field>
        <field name="arch" type="xml">
            <form string="Device Log">
                <sheet>
                    <group>
                        <group>
                            <field name="branch_id"/>
                            <field name="device_id"/>
                            <field name="controller_id"/>
                            <field name="event_type"/>
                            <field name="changed_at"/>
                        </group>
                        <group>
                            <field name="old_status"/>
                            <field name="new_status"/>
                        </group>
                    </group>
                    <group>
                        <field name="note"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="t4_gate_keeper_device_log_view_search" model="ir.ui.view">
        <field name="name">t4.gate_keeper.device_log.view.search</field>
        <field name="model">t4.gate_keeper.device_log</field>
        <field name="arch" type="xml">
            <search string="Search Device Logs">
                <field name="device_id" string="Device"/>
                <field name="controller_id" string="Controller"/>
                <group expand="1" string="Group By">
                    <filter string="Branch" name="group_branch" context="{'group_by': 'branch_id'}"/>
                    <filter string="Controller" name="group_controller" context="{'group_by': 'controller_id'}"/>
                    <filter string="Device" name="group_device" context="{'group_by': 'device_id'}"/>
                    <filter string="Event Type" name="group_event_type" context="{'group_by': 'event_type'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="t4_gate_keeper_device_log_action" model="ir.actions.act_window">
        <field name="name">Device Logs</field>
        <field name="res_model">t4.gate_keeper.device_log</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="t4_gate_keeper_device_log_view_search"/>
        <field name="context">{'search_default_group_branch': 1}</field>
    </record>
</odoo>
