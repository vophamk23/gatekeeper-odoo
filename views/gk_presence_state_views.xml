<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="t4_gate_keeper_presence_state_view_list" model="ir.ui.view">
        <field name="name">t4.gate_keeper.presence_state.view.list</field>
        <field name="model">t4.gate_keeper.presence_state</field>
        <field name="arch" type="xml">
            <list string="Presence States">
                <field name="employee_id"/>
                <field name="branch_id"/>
                <field name="area_id"/>
                <field name="state"/>
                <field name="last_seen_at"/>
            </list>
        </field>
    </record>

    <record id="t4_gate_keeper_presence_state_view_form" model="ir.ui.view">
        <field name="name">t4.gate_keeper.presence_state.view.form</field>
        <field name="model">t4.gate_keeper.presence_state</field>
        <field name="arch" type="xml">
            <form string="Presence State">
                <sheet>
                    <group>
                        <group>
                            <field name="employee_id"/>
                            <field name="branch_id"/>
                            <field name="area_id"/>
                        </group>
                        <group>
                            <field name="state"/>
                            <field name="last_seen_at"/>
                        </group>
                    </group>
                    <group>
                        <field name="notes"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="t4_gate_keeper_presence_state_action" model="ir.actions.act_window">
        <field name="name">Presence States</field>
        <field name="res_model">t4.gate_keeper.presence_state</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
