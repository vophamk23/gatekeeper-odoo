<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- ═══════════════════════════════════════════════════ -->
        <!-- LIST VIEW                                           -->
        <!-- ═══════════════════════════════════════════════════ -->
        <record id="t4_gate_keeper_employee_view_list" model="ir.ui.view">
            <field name="name">t4.gate_keeper.employee.view.list</field>
            <field name="model">t4.gate_keeper.employee</field>
            <field name="arch" type="xml">
                <list string="Employees" decoration-muted="not active" create="0">
                    <field name="emp_id" string="Employee ID"/>
                    <field name="name" string="Full Name"/>
                    <field name="hr_employee_id" string="HR Employee" optional="show"/>
                    <field name="group_ids" widget="many2many_tags" options="{'color_field': 'color'}" string="Nhóm đối tượng" optional="show"/>
                    <field name="branch_id" string="Branch"/>
                    <field name="presence_state"
                           string="Presence"
                           widget="badge"
                           decoration-success="presence_state == 'inside'"
                           decoration-primary="presence_state == 'outside'"
                           decoration-muted="presence_state == 'unknown'"/>
                    <field name="current_area_id" string="Current Area" optional="show"/>
                    <field name="active" column_invisible="True"/>
                </list>
            </field>
        </record>

        <!-- ═══════════════════════════════════════════════════ -->
        <!-- KANBAN VIEW                                         -->
        <!-- ═══════════════════════════════════════════════════ -->
        <record id="t4_gate_keeper_employee_view_kanban" model="ir.ui.view">
            <field name="name">t4.gate_keeper.employee.view.kanban</field>
            <field name="model">t4.gate_keeper.employee</field>
            <field name="arch" type="xml">
                <kanban default_group_by="presence_state" sample="1" create="0">
                    <field name="id"/>
                    <field name="name"/>
                    <field name="emp_id"/>
                    <field name="branch_id"/>
                    <field name="presence_state"/>
                    <field name="avatar"/>
                    <field name="active"/>
                    <templates>
                        <t t-name="card">
                            <div class="d-flex align-items-start gap-3 p-2">
                                <!-- Avatar -->
                                <div class="o_kanban_image_box" style="width: 50px; height: 50px; flex-shrink: 0;">
                                    <t t-if="record.avatar.raw_value">
                                        <img t-att-src="'/web/image/t4.gate_keeper.employee/' + record.id.raw_value + '/avatar'"
                                             class="rounded-circle w-100 h-100 object-fit-cover"
                                             alt="Avatar"/>
                                    </t>
                                    <t t-else="">
                                        <div class="rounded-circle w-100 h-100 d-flex align-items-center justify-content-center bg-light text-secondary fw-bold"
                                             style="border: 1px solid #ddd; font-size: 18px;">
                                            <t t-esc="record.name.raw_value.charAt(0).toUpperCase()"/>
                                        </div>
                                    </t>
                                </div>
                                <!-- Info -->
                                <div class="flex-grow-1" style="min-width: 0;">
                                    <div class="d-flex align-items-center justify-content-between mb-1">
                                        <strong class="text-truncate" style="font-size: 14px; max-width: 80%;">
                                            <field name="name"/>
                                        </strong>
                                    </div>
                                    <div class="text-muted mb-1" style="font-size: 11px;">
                                        🆔 <field name="emp_id"/>
                                    </div>
                                    <div t-if="record.branch_id.raw_value" class="text-muted" style="font-size: 11px;">
                                        🏢 <field name="branch_id"/>
                                    </div>
                                </div>
                            </div>
                            <div t-if="!record.active.raw_value"
                                 class="card-footer bg-transparent border-top-0 pt-0 pb-2 px-2"
                                 style="font-size: 10px;">
                                <span class="text-danger" style="font-weight: 500;">📌 Archived</span>
                            </div>
                        </t>
                    </templates>
                </kanban>
            </field>
        </record>

        <!-- ═══════════════════════════════════════════════════ -->
        <!-- FORM VIEW                                           -->
        <!-- ═══════════════════════════════════════════════════ -->
        <record id="t4_gate_keeper_employee_view_form" model="ir.ui.view">
            <field name="name">t4.gate_keeper.employee.view.form</field>
            <field name="model">t4.gate_keeper.employee</field>
            <field name="arch" type="xml">
                <form string="Employee" create="0">
                    <sheet>
                        <!-- Stat buttons -->
                        <div class="oe_button_box" name="button_box">
                            <button name="toggle_active"
                                    type="object"
                                    class="oe_stat_button"
                                    icon="fa-archive">
                                <field name="active"
                                       widget="boolean_button"
                                       options='{"terminology": "archive"}'/>
                            </button>
                        </div>

                        <!-- Avatar -->
                        <field name="avatar"
                               widget="image"
                               class="oe_avatar"
                               options="{'preview_image': 'avatar', 'size': [90, 90]}"/>

                        <!-- Title -->
                        <div class="oe_title">
                            <label for="name" string="Full Name"/>
                            <h1>
                                <field name="name" placeholder="e.g. Nguyen Van A"/>
                            </h1>
                        </div>

                        <!-- Fields -->
                        <group>
                            <group string="Identification">
                                <field name="emp_id"/>
                                <field name="hr_employee_id"/>
                                <field name="branch_id"/>
                            </group>
                            <group string="Presence">
                                <field name="presence_state"
                                       widget="badge"
                                       decoration-success="presence_state == 'inside'"
                                       decoration-primary="presence_state == 'outside'"
                                       decoration-muted="presence_state == 'unknown'"/>
                                <field name="current_area_id"
                                       readonly="1"
                                       invisible="presence_state != 'inside'"/>
                            </group>
                        </group>

                        <notebook>
                            <!-- Tab: ID Cards (Auth Info) -->
                            <page string="ID Cards" name="cards">
                                <field name="auth_info_ids" context="{'default_employee_id': id}">
                                    <list string="RFID Cards"
                                          decoration-muted="not active">
                                        <field name="card_code" string="Card Code"/>
                                        <field name="active" string="Active" widget="boolean_toggle"/>
                                        <field name="description" string="Description"/>
                                    </list>
                                </field>
                            </page>

                            <!-- Tab: Biometrics -->
                            <page string="Biometrics" name="biometrics">
                                <field name="biometric_ids" context="{'default_employee_id': id}">
                                    <list string="Biometric Data">
                                        <field name="algorithm_id" string="Algorithm"/>
                                        <field name="biometric_type" string="Type" readonly="1"/>
                                        <field name="finger_index" string="Finger / Slot"/>
                                        <field name="template" widget="binary" string="Template"/>
                                        <field name="description" string="Description"/>
                                    </list>
                                </field>
                            </page>

                            <!-- Tab: Groups -->
                            <page string="Groups" name="groups">
                                <field name="group_ids">
                                    <list string="Groups">
                                        <field name="name"/>
                                        <field name="code"/>
                                        <field name="branch_id"/>
                                        <field name="active"/>
                                    </list>
                                </field>
                            </page>
                        </notebook>
                    </sheet>
                    <chatter/>
                </form>
            </field>
        </record>

        <!-- ═══════════════════════════════════════════════════ -->
        <!-- SEARCH VIEW                                         -->
        <!-- ═══════════════════════════════════════════════════ -->
        <record id="t4_gate_keeper_employee_view_search" model="ir.ui.view">
            <field name="name">t4.gate_keeper.employee.view.search</field>
            <field name="model">t4.gate_keeper.employee</field>
            <field name="arch" type="xml">
                <search string="Search Employees">
                    <field name="name" string="Full Name"/>
                    <field name="emp_id" string="Employee ID"/>
                    <field name="hr_employee_id" string="HR Employee"/>
                    <field name="branch_id" string="Branch"/>
                    <separator/>
                    <filter string="Inside" name="inside" domain="[('presence_state', '=', 'inside')]"/>
                    <filter string="Outside" name="outside" domain="[('presence_state', '=', 'outside')]"/>
                    <separator/>
                    <filter string="Active" name="active" domain="[('active', '=', True)]"/>
                    <filter string="Archived" name="archived" domain="[('active', '=', False)]"/>
                    <separator/>
                    <filter string="Branch" name="group_branch" context="{'group_by': 'branch_id'}"/>
                    <filter string="Presence" name="group_presence" context="{'group_by': 'presence_state'}"/>
                </search>
            </field>
        </record>

        <!-- ═══════════════════════════════════════════════════ -->
        <!-- ACTION WINDOW                                       -->
        <!-- ═══════════════════════════════════════════════════ -->
        <record id="t4_gate_keeper_employee_action" model="ir.actions.act_window">
            <field name="name">Employees</field>
            <field name="res_model">t4.gate_keeper.employee</field>
            <field name="view_mode">list,kanban,form</field>
            <field name="context">{"active_test": False, "search_default_group_branch": 1}</field>
            <field name="search_view_id" ref="t4_gate_keeper_employee_view_search"/>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    No employees yet!
                </p>
                <p>
                    Create employee profiles and assign RFID cards to manage their access.
                </p>
            </field>
        </record>

    </data>
</odoo>
