<odoo>
  <record id="view_gate_keeper_access_log_tree" model="ir.ui.view">
    <field name="name">t4.gate_keeper.access_log.tree</field>
    <field name="model">t4.gate_keeper.access_log</field>
    <field name="arch" type="xml">
      <tree string="Access Logs">
        <field name="access_time"/>
        <field name="employee_id"/>
        <field name="device_id"/>
        <field name="direction"/>
        <field name="verification_type"/>
        <field name="branch_id"/>
        <field name="area_id"/>
      </tree>
    </field>
  </record>

  <record id="view_gate_keeper_access_log_form" model="ir.ui.view">
    <field name="name">t4.gate_keeper.access_log.form</field>
    <field name="model">t4.gate_keeper.access_log</field>
    <field name="arch" type="xml">
      <form string="Access Log">
        <sheet>
          <group>
            <field name="access_time"/>
            <field name="employee_id"/>
            <field name="device_id"/>
            <field name="controller_id"/>
            <field name="direction"/>
            <field name="verification_type"/>
            <field name="sync_status"/>
            <field name="is_system_generated"/>
            <field name="branch_id"/>
            <field name="area_id"/>
          </group>
        </sheet>
      </form>
    </field>
  </record>

  <record id="t4_gate_keeper_access_log_action" model="ir.actions.act_window">
    <field name="name">Access Logs</field>
    <field name="res_model">t4.gate_keeper.access_log</field>
    <field name="view_mode">tree,form</field>
  </record>
</odoo>
