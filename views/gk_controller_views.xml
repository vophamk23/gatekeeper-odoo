<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Controller Views -->
    <record id="t4_gate_keeper_controller_view_list" model="ir.ui.view">
        <field name="name">t4.gate_keeper.controller.view.list</field>
        <field name="model">t4.gate_keeper.controller</field>
        <field name="arch" type="xml">
            <list default_group_by="branch_id">
                <field name="name"/>
                <field name="branch_id"/>
                <field name="last_heartbeat_at"/>
                <field name="last_sync_at"/>
                <field  name="status" 
                        widget="badge"
                        decoration-success="status == 'online'"
                        decoration-danger="status == 'offline'"/>
            </list>
        </field>
    </record>

    <record id="t4_gate_keeper_controller_view_form" model="ir.ui.view">
        <field name="name">t4.gate_keeper.controller.view.form</field>
        <field name="model">t4.gate_keeper.controller</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="serial_number"/>
                            <field name="branch_id"/>
                            <field name="connection_type"/>
                            <field name="timezone"/>
                        </group>
                        <group>
                            <field name="status"/>
                            <field name="ip_address"/>
                            <field name="mac_address"/>
                            <field name="hardware_model"/>
                            <field name="firmware_version"/>
                        </group>
                        <group>
                            <field name="last_heartbeat_at" readonly="1"/>
                            <field name="last_sync_at" readonly="1"/>
                            <field name="installed_at"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Devices" name="devices">
                            <field name="device_ids">
                                <list>
                                    <field name="name"/>
                                    <field name="device_model_id"/>
                                    <field name="serial_number"/>
                                    <field name="port_or_channel"/>
                                    <field name="status"
                                           widget="badge"
                                           decoration-success="status == 'online'"
                                           decoration-danger="status == 'offline'"
                                           decoration-warning="status == 'controller_offline'"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="t4_gate_keeper_controller_view_search" model="ir.ui.view">
        <field name="name">t4.gate_keeper.controller.view.search</field>
        <field name="model">t4.gate_keeper.controller</field>
        <field name="arch" type="xml">
            <search string="Search Controllers">
                <field name="name" string="Controller Name"/>
                <field name="serial_number" string="Serial Number"/>
                <separator/>
                <filter string="Online" name="filter_online" domain="[('status', '=', 'online')]"/>
                <filter string="Offline" name="filter_offline" domain="[('status', '=', 'offline')]"/>
                <group expand="1" string="Group By">
                    <filter string="Branch" name="group_branch" context="{'group_by': 'branch_id'}"/>
                    <filter string="Status" name="group_status" context="{'group_by': 'status'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="t4_gate_keeper_controller_action" model="ir.actions.act_window">
        <field name="name">Controllers</field>
        <field name="res_model">t4.gate_keeper.controller</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="t4_gate_keeper_controller_view_search"/>
        <field name="context">{'search_default_group_branch': 1}</field>
    </record>

</odoo>
