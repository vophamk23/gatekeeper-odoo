<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="t4_gate_keeper_auth_info_view_list" model="ir.ui.view">
        <field name="name">t4.gate_keeper.auth_info.view.list</field>
        <field name="model">t4.gate_keeper.auth_info</field>
        <field name="arch" type="xml">
            <list string="Authentication Information">
                <field name="employee_id"/>
                <field name="card_code"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="t4_gate_keeper_auth_info_view_form" model="ir.ui.view">
        <field name="name">t4.gate_keeper.auth_info.view.form</field>
        <field name="model">t4.gate_keeper.auth_info</field>
        <field name="arch" type="xml">
            <form string="Auth Info">
                <sheet>
                    <group>
                        <group>
                            <field name="employee_id"/>
                            <field name="card_code"/>
                        </group>
                        <group>
                            <field name="active"/>
                        </group>
                    </group>
                    <group>
                        <field name="description"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="t4_gate_keeper_auth_info_action" model="ir.actions.act_window">
        <field name="name">Authentication Information</field>
        <field name="res_model">t4.gate_keeper.auth_info</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
