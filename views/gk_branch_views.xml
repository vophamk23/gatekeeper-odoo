<odoo>
  <record id="view_gate_keeper_branch_tree" model="ir.ui.view">
    <field name="name">t4.gate_keeper.branch.tree</field>
    <field name="model">t4.gate_keeper.branch</field>
    <field name="arch" type="xml">
      <list string="Branches">
        <field name="name"/>
        <field name="company_id"/>
        <field name="timezone"/>
        <field name="active"/>
      </list>
    </field>
  </record>

  <record id="view_gate_keeper_branch_form" model="ir.ui.view">
    <field name="name">t4.gate_keeper.branch.form</field>
    <field name="model">t4.gate_keeper.branch</field>
    <field name="arch" type="xml">
      <form string="Branch">
        <sheet>
          <group>
            <field name="name"/>
            <field name="company_id"/>
            <field name="timezone"/>
            <field name="address"/>
            <field name="active"/>
          </group>
          <notebook>
            <page string="Areas">
              <field name="area_ids">
                <list editable="bottom">
                  <field name="name"/>
                </list>
              </field>
            </page>
            <page string="Controllers">
              <field name="controller_ids">
                <list editable="bottom">
                  <field name="name"/>
                  <field name="status"/>
                </list>
              </field>
            </page>
            <page string="Devices">
              <field name="device_ids"/>
            </page>
          </notebook>
        </sheet>
      </form>
    </field>
  </record>

  <record id="t4_gate_keeper_branch_action" model="ir.actions.act_window">
    <field name="name">Branches</field>
    <field name="res_model">t4.gate_keeper.branch</field>
    <field name="view_mode">list,form</field>
  </record>
</odoo>
