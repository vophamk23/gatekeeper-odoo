<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- LIST VIEW -->
    <record id="t4_gate_keeper_area_warning_extra_view_list" model="ir.ui.view">
        <field name="name">t4.gate_keeper.area_warning.view.list</field>
        <field name="model">t4.gate_keeper.area_warning</field>
        <field name="arch" type="xml">
            <list string="Area Warnings" create="false" delete="false">
                <field name="create_date" string="Detected At"/>
                <field name="branch_id" optional="show"/>
                <field name="area_id" optional="show"/>
                <field name="warning_type_code" column_invisible="True"/>
                <field name="warning_type_id"
                       widget="badge"
                       decoration-danger="warning_type_code == 'invalid_sequence'"
                       decoration-warning="warning_type_code == 'unauthorized_area'"
                       decoration-primary="warning_type_code == 'unknown_card'"
                       decoration-info="warning_type_code == 'device_issue'"
                       decoration-success="warning_type_code == 'unauthorized_time'"
                       decoration-muted="warning_type_code == 'overtime'"/>
                <field name="employee_id" optional="show"/>
                <field name="device_id" optional="show"/>
                <field name="priority"
                       widget="badge"
                       decoration-danger="priority == 'critical'"
                       decoration-warning="priority == 'high'"
                       decoration-info="priority == 'medium'"
                       decoration-muted="priority == 'low'"
                       optional="show"/>
                <field name="state"
                       widget="badge"
                       decoration-danger="state == 'warning'"
                       decoration-success="state == 'resolved'"
                       optional="show"/>
                <button name="action_resolve" string="Resolve" type="object"
                        class="btn-sm btn-secondary"
                        invisible="state == 'resolved'"/>
            </list>
        </field>
    </record>

    <!-- FORM VIEW -->
    <record id="t4_gate_keeper_area_warning_extra_view_form" model="ir.ui.view">
        <field name="name">t4.gate_keeper.area_warning.view.form</field>
        <field name="model">t4.gate_keeper.area_warning</field>
        <field name="arch" type="xml">
            <form string="Area Warning">
                <header>
                    <button name="action_resolve"
                            string="Mark as Resolved"
                            type="object"
                            class="btn-primary"
                            invisible="state == 'resolved'"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="warning,resolved"/>
                </header>
                <sheet>
                    <group>
                        <group string="Warning Info">
                            <field name="area_id"/>
                            <field name="warning_type_id"/>
                            <field name="priority"
                                   widget="badge"
                                   decoration-danger="priority == 'critical'"
                                   decoration-warning="priority == 'high'"/>
                            <field name="escalated_at" readonly="1"/>
                        </group>
                        <group string="Source">
                            <field name="device_id"/>
                            <field name="employee_id"/>
                            <field name="access_log_id"/>
                            <field name="policy_id"/>
                        </group>
                    </group>
                    <group string="Description">
                        <field name="description" nolabel="1" readonly="1"/>
                    </group>
                    <group string="Resolution" invisible="state == 'warning'">
                        <group>
                            <field name="resolved_by_id" readonly="1"/>
                            <field name="resolved_at" readonly="1"/>
                        </group>
                        <group>
                            <field name="resolution_notes"/>
                        </group>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- SEARCH VIEW -->
    <record id="t4_gate_keeper_area_warning_view_search" model="ir.ui.view">
        <field name="name">t4.gate_keeper.area_warning.view.search</field>
        <field name="model">t4.gate_keeper.area_warning</field>
        <field name="arch" type="xml">
            <search string="Search Area Warnings">
                <field name="branch_id" string="Branch"/>
                <field name="employee_id" string="Employee"/>
                <field name="device_id" string="Device"/>
                <field name="area_id" string="Area"/>
                <field name="warning_type_id" string="Warning Type"/>
                <separator/>
                <filter string="Active Warnings" name="unresolved" domain="[('state', '=', 'warning')]"/>
                <filter string="Resolved Warnings" name="resolved" domain="[('state', '=', 'resolved')]"/>
                <separator/>
                <filter string="Critical Priority" name="priority_critical" domain="[('priority', '=', 'critical')]"/>
                <filter string="High Priority" name="priority_high" domain="[('priority', '=', 'high')]"/>
                <separator/>
                <filter string="Branch" name="group_branch" context="{'group_by': 'branch_id'}"/>
                <filter string="Status" name="group_state" context="{'group_by': 'state'}"/>
                <filter string="Priority" name="group_priority" context="{'group_by': 'priority'}"/>
                <filter string="Area" name="group_area" context="{'group_by': 'area_id'}"/>
                <filter string="Warning Type" name="group_warning_type" context="{'group_by': 'warning_type_id'}"/>
                <filter string="Detection Date" name="group_date" context="{'group_by': 'create_date:day'}"/>
            </search>
        </field>
    </record>

    <!-- ACTION -->
    <record id="t4_gate_keeper_area_warning_extra_action" model="ir.actions.act_window">
        <field name="name">Area Warnings</field>
        <field name="res_model">t4.gate_keeper.area_warning</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="t4_gate_keeper_area_warning_extra_view_list"/>
        <field name="search_view_id" ref="t4_gate_keeper_area_warning_view_search"/>
        <field name="context">{'search_default_unresolved': 1, 'search_default_group_branch': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Great! No active warnings.
            </p>
            <p>
                The system automatically creates warnings when security rules are breached or devices go offline.
            </p>
        </field>
    </record>
</odoo>
