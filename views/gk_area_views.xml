<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Area List View -->
    <record id="t4_gate_keeper_area_view_list" model="ir.ui.view">
        <field name="name">t4.gate_keeper.area.view.list</field>
        <field name="model">t4.gate_keeper.area</field>
        <field name="arch" type="xml">
            <list string="Areas">
                <field name="name"/>
                <field name="branch_id"/>
                <field name="warning_count" string="Active Warnings"/>
                <field name="status"
                       widget="badge"
                       decoration-success="status == 'normal'"
                       decoration-warning="status == 'warning'"/>
            </list>
        </field>
    </record>

    <!-- Area Form View -->
    <record id="t4_gate_keeper_area_view_form" model="ir.ui.view">
        <field name="name">t4.gate_keeper.area.view.form</field>
        <field name="model">t4.gate_keeper.area</field>
        <field name="arch" type="xml">
            <form string="Area">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_warnings"
                                type="object"
                                class="oe_stat_button"
                                icon="fa-exclamation-triangle"
                                invisible="warning_count == 0">
                            <field name="warning_count" widget="statinfo" string="Warnings"/>
                        </button>
                    </div>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="branch_id"/>
                            <field name="status"
                                   widget="badge"
                                   decoration-success="status == 'normal'"
                                   decoration-warning="status == 'warning'"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Devices" name="devices">
                            <field name="device_ids">
                                <list>
                                    <field name="name"/>
                                    <field name="serial_number"/>
                                    <field name="device_model_id"/>
                                    <field name="status"
                                           widget="badge"
                                           decoration-success="status == 'online'"
                                           decoration-danger="status == 'offline'"
                                           decoration-warning="status == 'controller_offline'"/>
                                </list>
                            </field>
                        </page>
                        <page string="Active Warnings" name="warnings">
                            <field name="warning_ids" domain="[('state','=','warning')]">
                                <list create="false" delete="false"
                                      decoration-danger="priority == 'critical'"
                                      decoration-warning="priority == 'high'">
                                    <field name="create_date" string="Detected At"/>
                                    <field name="warning_type_id"/>
                                    <field name="employee_id"/>
                                    <field name="device_id"/>
                                    <field name="priority" widget="badge"
                                           decoration-danger="priority == 'critical'"
                                           decoration-warning="priority == 'high'"/>
                                    <field name="state" widget="badge"
                                           decoration-danger="state == 'warning'"
                                           decoration-success="state == 'resolved'"/>
                                    <button name="action_resolve" string="Resolve"
                                            type="object" class="btn-sm btn-secondary"
                                            invisible="state == 'resolved'"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- Warning list embedded in Area (from gk_area_views original) -->
    <record id="t4_gate_keeper_area_warning_view_list" model="ir.ui.view">
        <field name="name">t4.gate_keeper.area_warning.view.list</field>
        <field name="model">t4.gate_keeper.area_warning</field>
        <field name="arch" type="xml">
            <list string="Area Warnings" create="false" delete="false">
                <field name="area_id"/>
                <field name="warning_type_id"/>
                <field name="employee_id"/>
                <field name="device_id"/>
                <field name="create_date" string="Detected At"/>
                <field name="state"
                       widget="badge"
                       decoration-danger="state == 'warning'"
                       decoration-success="state == 'resolved'"/>
                <field name="priority"
                       widget="badge"
                       decoration-danger="priority == 'critical'"
                       decoration-warning="priority == 'high'"/>
                <button name="action_resolve" string="Resolve" type="object"
                        class="btn-sm btn-secondary"
                        invisible="state == 'resolved'"/>
            </list>
        </field>
    </record>

    <!-- Area Search View -->
    <record id="t4_gate_keeper_area_view_search" model="ir.ui.view">
        <field name="name">t4.gate_keeper.area.view.search</field>
        <field name="model">t4.gate_keeper.area</field>
        <field name="arch" type="xml">
            <search string="Search Areas">
                <field name="name" string="Area Name"/>
                <field name="branch_id" string="Branch"/>
                <group expand="1" string="Group By">
                    <filter string="Branch" name="group_branch" context="{'group_by': 'branch_id'}"/>
                    <filter string="Status" name="group_status" context="{'group_by': 'status'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Area Warning Type action (used by menu) -->
    <record id="t4_gate_keeper_area_warning_type_action" model="ir.actions.act_window">
        <field name="name">Warning Types</field>
        <field name="res_model">t4.gate_keeper.area_warning_type</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- Area action -->
    <record id="t4_gate_keeper_area_action" model="ir.actions.act_window">
        <field name="name">Areas</field>
        <field name="res_model">t4.gate_keeper.area</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="t4_gate_keeper_area_view_search"/>
        <field name="context">{'search_default_group_branch': 1}</field>
    </record>

</odoo>
