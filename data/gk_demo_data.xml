            <field name="code">POL-RD-RESTRICT-DN</field>
            <field name="warning_type_id" ref="warning_type_unauthorized_area"/>
            <field name="priority">critical</field>
            <field name="branch_ids" eval="[(6, 0, [ref('branch_danang_office')])]"/>
            <field name="area_ids" eval="[(6, 0, [ref('area_dn_tech')])]"/>
            <field name="allowed_group_ids" eval="[(6, 0, [ref('group_dn_it')])]"/>
            <field name="description">Quy tắc bảo mật Đà Nẵng: Chỉ nhóm IT Đà Nẵng được phép vào phòng nghiên cứu phát triển R&amp;D.</field>
        </record>

        <!-- UNIFIED TEMP STAFF CURFEW POLICY (ALL BRANCHES) -->
        <record id="policy_temp_curfew" model="t4.gate_keeper.alert_policy">
            <field name="name">Nhân viên thời vụ không được vào ngoài giờ và cuối tuần (Toàn quốc)</field>
            <field name="code">POL-TEMP-CURFEW</field>
            <field name="warning_type_id" ref="warning_type_unauthorized_time"/>
            <field name="priority">high</field>
            <field name="branch_ids" eval="[(6, 0, [ref('branch_hanoi_hq'), ref('branch_hcm_office'), ref('branch_danang_office')])]"/>
            <field name="employee_group_ids" eval="[(6, 0, [ref('group_hn_temp'), ref('group_hcm_temp'), ref('group_dn_temp')])]"/>
            <field name="start_hour">18.0</field>
            <field name="end_hour">8.0</field>
            <field name="apply_weekend" eval="True"/>
            <field name="description">Cấm truy cập toàn quốc: Nhân viên thời vụ / nhà thầu tại tất cả chi nhánh không được phép vào ngoài giờ hành chính hoặc cuối tuần.</field>
        </record>

        <!-- ANTI-PASSBACK POLICY (ALL BRANCHES) -->
        <record id="policy_apb_enforce" model="t4.gate_keeper.alert_policy">
            <field name="name">Giám sát chống xoay vòng thẻ Anti-passback</field>
            <field name="code">POL-APB-ENFORCE</field>
            <field name="warning_type_id" ref="warning_type_invalid_sequence"/>
            <field name="priority">critical</field>
            <field name="branch_ids" eval="[(6, 0, [ref('branch_hanoi_hq'), ref('branch_hcm_office'), ref('branch_danang_office')])]"/>
            <field name="description">Quy tắc chống quay vòng thẻ: Hệ thống sẽ giám sát trình tự ra/vào của tất cả nhân viên tại tất cả chi nhánh.</field>
        </record>

        <!-- UNKNOWN CARD POLICY (ALL BRANCHES) -->
        <record id="policy_unknown_card_monitor" model="t4.gate_keeper.alert_policy">
            <field name="name">Giám sát và phát hiện thẻ chưa đăng ký</field>
            <field name="code">POL-UNKNOWN-CARD-MONITOR</field>
            <field name="warning_type_id" ref="warning_type_unknown_card"/>
