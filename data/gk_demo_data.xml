        <!-- 5. ALERT POLICIES -->
        
        <!-- HANOI SECURITY POLICY -->
        <record id="policy_server_restrict" model="t4.gate_keeper.alert_policy">
            <field name="name">Chỉ kỹ thuật và bảo vệ được vào Phòng Máy Chủ (Hà Nội)</field>
            <field name="code">POL-SRV-RESTRICT-HN</field>
            <field name="warning_type_id" ref="warning_type_unauthorized_area"/>
            <field name="priority">critical</field>
            <field name="branch_ids" eval="[(6, 0, [ref('branch_hanoi_hq')])]"/>
            <field name="area_ids" eval="[(6, 0, [ref('area_hn_server')])]"/>
            <field name="allowed_group_ids" eval="[(6, 0, [ref('group_hn_it'), ref('group_hn_security'), ref('group_hn_board')])]"/>
            <field name="description">Quy tắc nghiêm ngặt Hà Nội: Chỉ nhóm IT, Bảo vệ và Ban Giám Đốc Hà Nội được phép vào phòng máy chủ HN.</field>
        </record>

        <!-- DA NANG SECURITY POLICY -->
        <record id="policy_tech_restrict_dn" model="t4.gate_keeper.alert_policy">
