<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- 1. BIOMETRIC ALGORITHMS -->
        <record id="algorithm_zk_finger" model="t4.gate_keeper.algorithm">
            <field name="name">ZKTeco Fingerprint Recognition</field>
            <field name="code">fingerprint_zk_v10</field>
            <field name="algorithm_type">fingerprint</field>
            <field name="version">10.0</field>
            <field name="template_format">zk_ansi_378</field>
            <field name="notes">Thuật toán quét vân tay ANSI-378 tiêu chuẩn của hãng ZKTeco.</field>
        </record>

        <record id="algorithm_hik_face" model="t4.gate_keeper.algorithm">
            <field name="name">Hikvision Face 3D Recognition</field>
            <field name="code">face_hik_v2.1</field>
            <field name="algorithm_type">face</field>
            <field name="version">2.1</field>
            <field name="template_format">hik_face_feature</field>
            <field name="notes">Thuật toán nhận diện khuôn mặt 3D chống giả mạo của Hikvision.</field>
        </record>

        <record id="algorithm_standard_card" model="t4.gate_keeper.algorithm">
            <field name="name">Standard RFID Card Authentication</field>
            <field name="code">card_standard</field>
            <field name="algorithm_type">card</field>
            <field name="version">1.0</field>
            <field name="notes">Thuật toán đọc thẻ từ tần số 13.56MHz Mifare / 125KHz Proximity.</field>
        </record>

        <!-- 2. DEVICE MODELS -->
        <record id="model_zk_speedface" model="t4.gate_keeper.device_model">
            <field name="name">ZKTeco SpeedFace V5L</field>
            <field name="algorithm_ids" eval="[(6, 0, [ref('algorithm_zk_finger'), ref('algorithm_hik_face'), ref('algorithm_standard_card')])]"/>
        </record>

        <record id="model_suprema_bioentry" model="t4.gate_keeper.device_model">
            <field name="name">Suprema BioEntry W2</field>
            <field name="algorithm_ids" eval="[(6, 0, [ref('algorithm_zk_finger'), ref('algorithm_standard_card')])]"/>
        </record>

        <record id="model_hik_dsk" model="t4.gate_keeper.device_model">
            <field name="name">Hikvision DS-K1T671</field>
            <field name="algorithm_ids" eval="[(6, 0, [ref('algorithm_hik_face'), ref('algorithm_standard_card')])]"/>
        </record>

