<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- Thẻ lạ / thẻ chưa đăng ký -->
        <record id="warning_type_unknown_card" model="t4.gate_keeper.area_warning_type">
            <field name="name">Unknown Card</field>
            <field name="code">unknown_card</field>
            <field name="condition_type">unknown_card</field>
            <field name="description">Quẹt thẻ chưa đăng ký hoặc không tìm thấy hồ sơ nhân viên.</field>
        </record>

        <!-- Ngoài giờ quy định -->
        <record id="warning_type_unauthorized_time" model="t4.gate_keeper.area_warning_type">
            <field name="name">Unauthorized Time</field>
            <field name="code">unauthorized_time</field>
            <field name="condition_type">unauthorized_time</field>
            <field name="description">Quẹt thẻ ngoài khung giờ được phép hoặc vào cuối tuần.</field>
        </record>

        <!-- Vi phạm anti-passback -->
        <record id="warning_type_invalid_sequence" model="t4.gate_keeper.area_warning_type">
            <field name="name">Invalid Sequence (Anti-Passback)</field>
            <field name="code">invalid_sequence</field>
            <field name="condition_type">invalid_sequence</field>
            <field name="description">Trình tự ra/vào không hợp lệ — vi phạm anti-passback.</field>
        </record>

        <!-- Khu vực không được phép -->
        <record id="warning_type_unauthorized_area" model="t4.gate_keeper.area_warning_type">
            <field name="name">Unauthorized Area</field>
            <field name="code">unauthorized_area</field>
            <field name="condition_type">unauthorized_area</field>
            <field name="description">Nhân viên vào khu vực không thuộc phạm vi quyền hạn.</field>
        </record>

        <!-- Thiết bị offline -->
        <record id="warning_type_device_issue" model="t4.gate_keeper.area_warning_type">
            <field name="name">Device Issue</field>
            <field name="code">device_issue</field>
            <field name="condition_type">device_offline</field>
            <field name="description">Thiết bị hoặc controller bị mất kết nối.</field>
        </record>

        <!-- Overtime — ở lại quá giờ -->
        <record id="warning_type_overtime" model="t4.gate_keeper.area_warning_type">
            <field name="name">Overtime</field>
            <field name="code">overtime</field>
            <field name="condition_type">overtime</field>
            <field name="description">Nhân viên ở trong khu vực vượt ngưỡng thời gian cho phép.</field>
        </record>

    </data>
</odoo>
