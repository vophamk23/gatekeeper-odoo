# ------------------------------------------------------------------------------
# CHỨC NĂNG: Thẻ lạ 777 quẹt RA.
# KẾT QUẢ: Tạo Access Log và tạo cảnh báo thẻ lạ (unknown_card - Màu tím).
# ------------------------------------------------------------------------------
POST http://localhost:8070/api/v1/AccessLogUpload
Authorization: Bearer {{token}}
Content-Type: application/json

{
    "controller_id": "CTRL-HN-LOBBY-01",
    "logs": [
        {
            "device_serial": "DEV-HN-LOB-OUT-01",
            "card_code": "RFID-UNKNOWN-777",
            "direction": "out",
            "verification_type": "card"
        }
    ]
}

### 4.2.4.C Phát hiện thẻ lạ chưa đăng ký: Thẻ lạ 888 quẹt VÀO (Kho hàng HCM)
# ------------------------------------------------------------------------------
# CHỨC NĂNG: Gửi mã thẻ chưa đăng ký vào hệ thống tại Kho hàng TP. HCM.
# KẾT QUẢ: 
# - Tạo Access Log (không có nhân viên).
# - Tự động tạo cảnh báo thẻ lạ (unknown_card - Màu tím) tại Area Warning.
# ------------------------------------------------------------------------------
POST http://localhost:8070/api/v1/AccessLogUpload
Authorization: Bearer {{token}}
Content-Type: application/json

{
    "controller_id": "CTRL-HCM-WHS-01",
    "logs": [
        {
            "device_serial": "DEV-HCM-WHS-FGR-01",
            "card_code": "RFID-UNKNOWN-888",
            "direction": "in",
            "verification_type": "card"
        }
    ]
}

### 4.2.4.D Phát hiện thẻ lạ chưa đăng ký: Thẻ lạ 888 quẹt RA (Kho hàng HCM)
# ------------------------------------------------------------------------------
# CHỨC NĂNG: Thẻ lạ 888 quẹt RA tại Kho hàng TP. HCM.
# KẾT QUẢ: Tạo Access Log và tạo cảnh báo thẻ lạ (unknown_card - Màu tím).
# ------------------------------------------------------------------------------
POST http://localhost:8070/api/v1/AccessLogUpload
Authorization: Bearer {{token}}
Content-Type: application/json

{
    "controller_id": "CTRL-HCM-WHS-01",
    "logs": [
        {
            "device_serial": "DEV-HCM-WHS-FGR-01",
            "card_code": "RFID-UNKNOWN-888",
            "direction": "out",
            "verification_type": "card"
        }
    ]
}

