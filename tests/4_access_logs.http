### 4.2.1.A Vi phạm Ngoài giờ - Unauthorized Time: Phạm Văn Thời Vụ quẹt VÀO (Ngày thường)
# ------------------------------------------------------------------------------
# CHỨC NĂNG: CTV Thời vụ quẹt VÀO lúc 22:00 ngày thường (Ngoài giờ hành chính 08:00 - 18:00).
# KẾT QUẢ: 
# - Tạo 1 bản ghi Access Log.
# - Tự động tạo cảnh báo vi phạm thời gian (unauthorized_time - Màu xanh lá) tại Area Warning.
# ------------------------------------------------------------------------------
POST http://localhost:8070/api/v1/AccessLogUpload
Authorization: Bearer {{token}}
Content-Type: application/json

{
    "controller_id": "CTRL-HCM-WHS-01",
    "logs": [
        {
            "device_serial": "DEV-HCM-WHS-FGR-01",
            "emp_id": "EMP-HCM-TMP-001",
            "card_code": "RFID-HCM-TMP-01",
            "access_time": "2026-07-10 22:00:00",
            "direction": "in",
            "verification_type": "fingerprint"
        }
    ]
}

