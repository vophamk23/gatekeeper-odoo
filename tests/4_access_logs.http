### 4.2.1.A Vi phạm Ngoài giờ (Temp Staff Curfew): Nguyễn Thị Kim Anh quẹt VÀO (Ngày thường)
# ------------------------------------------------------------------------------
# CHỨC NĂNG: CTV Thời vụ quẹt VÀO lúc 22:00 ngày thường (Ngoài giờ quy định 20:00 - 06:00).
# KẾT QUẢ: 
# - Tạo 1 bản ghi Access Log.
# - Tự động tạo cảnh báo vi phạm thời gian (unauthorized_time) tại Area Warning (POL-TEMP-CURFEW).
# ------------------------------------------------------------------------------
POST http://localhost:8070/api/v1/AccessLogUpload
Authorization: Bearer {{token}}
Content-Type: application/json

{
    "controller_id": "CTRL-HCM-WHS-01",
    "logs": [
        {
            "device_serial": "DEV-HCM-WHS-FGR-01",
            "emp_id": "EMP-HCM-006",
            "card_code": "RFID-HCM-006",
            "access_time": "2026-07-10 22:00:00",
            "direction": "in",
            "verification_type": "fingerprint"
        }
    ]
}

